
node_modules/
dist/
html/
coverage/
.DS_Store

# Personal scratch scripts kept alongside the package build output.
# Scoped deliberately: a bare `scripts/` would also swallow website/scripts/,
# which holds the committed llms.txt generator.
packages/*/scripts/

# Claude Code: keep skills and plugin config in version control, ignore only
# the machine-local permission cache.
.claude/settings.local.json

# turbo local cache and per-package test output
.turbo/
reports/

# domain-explorer writes <codebase>.html into the cwd when --out is omitted, so
# running it from the repo root drops reports here. Two of them were committed
# once, and one rendered a private codebase's whole domain model into a public
# repository. Root-level only: the committed demo lives under website/static.
/*.html
