{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": [
        "NODE_ENV"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "build:release": {
      "env": [
        "NODE_ENV"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ],
      "dependsOn": [
        "^build:release"
      ]
    },
    "test": {
      "env": [
        "NODE_ENV"
      ],
      "outputs": [
        "reports/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "check:agents": {
      "outputs": []
    }
  }
}
