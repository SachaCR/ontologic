# Copy to .env and adjust: cp .env.example .env
# The CLI loads .env on start, and so do the broker tests (pnpm test:brokers).
# A variable already set in your shell wins over the file.

# Redis: the command stream (redis transport) and the response channels (redis and sqs).
# Point it at the Redis server itself, not at a RedisInsight UI (which serves HTTP, often on 5540).
# A database index (/1) keeps these keys apart from another project's on a shared server.
REDIS_URL=redis://127.0.0.1:6379

# SQS: LocalStack's endpoint. Leave it empty to use real AWS with your ambient credentials.
# When set, the CLI creates the command queue if it is missing.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# The Redis stream or SQS queue commands go through (".fifo" is added for sqs).
COMMAND_TOPIC=place-order-commands
