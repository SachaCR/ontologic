{
  "name": "command-bus-examples",
  "version": "1.0.0",
  "description": "Runnable command bus examples, and the home of the Redis and SQS connectors.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:release": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:report": "vitest run && vite preview --outDir reports",
    "example:in-memory": "pnpx tsx src/example.ts"
  },
  "keywords": [
    "ontologic",
    "command-bus",
    "redis",
    "sqs",
    "typescript"
  ],
  "author": "SachaCR",
  "license": "MIT",
  "dependencies": {
    "ontologic": "workspace:*",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
