{
  "name": "@ontologics/event-sourcing",
  "version": "0.2.1",
  "description": "Event sourcing for Ontologic domain entities: rebuild entity state by folding its event stream.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "build:release": "pnpm run clean && tsc --project tsconfig-release.json",
    "prepack": "pnpm run build:release",
    "test": "vitest run",
    "test:report": "vitest run && vite preview --outDir reports"
  },
  "keywords": [
    "ontologic",
    "event-sourcing",
    "event-store",
    "DDD",
    "domain-driven-design",
    "domain-events",
    "aggregate",
    "typescript"
  ],
  "author": "SachaCR",
  "license": "MIT",
  "homepage": "https://ontologic.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/SachaCR/ontologic.git",
    "directory": "packages/event-sourcing"
  },
  "bugs": {
    "url": "https://github.com/SachaCR/ontologic/issues"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
