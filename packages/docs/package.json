{
  "name": "ontologic-docs",
  "version": "0.1.0",
  "description": "Generate interactive HTML documentation from an Ontologic codebase: aggregates, value objects, domain events, typed errors, invariants, repositories and use cases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ontologic-docs": "./dist/cli.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:release": "tsc --project tsconfig-release.json",
    "test": "vitest run"
  },
  "keywords": [
    "ontologic",
    "DDD",
    "domain-driven-design",
    "documentation",
    "documentation-generator",
    "typescript"
  ],
  "author": "SachaCR",
  "license": "MIT",
  "homepage": "https://ontologic.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/SachaCR/ontologic.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/SachaCR/ontologic/issues"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
