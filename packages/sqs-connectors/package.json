{
  "name": "@ontologics/sqs-connectors",
  "version": "0.1.0",
  "description": "SQS connectors for the Ontologic command and event buses: FIFO queues processed one message group at a time, groups in parallel.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "build:release": "pnpm run clean && tsc --project tsconfig-release.json",
    "prepack": "pnpm run build:release",
    "test": "vitest run",
    "test:report": "vitest run && vite preview --outDir reports"
  },
  "keywords": [
    "ontologic",
    "command-bus",
    "sqs",
    "aws",
    "connector",
    "typescript"
  ],
  "author": "SachaCR",
  "license": "MIT",
  "homepage": "https://ontologic.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/SachaCR/ontologic.git",
    "directory": "packages/sqs-connectors"
  },
  "bugs": {
    "url": "https://github.com/SachaCR/ontologic/issues"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "fastq": "^1.20.1"
  },
  "peerDependencies": {
    "ontologic": ">=1.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "ontologic": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
