{
  "name": "@ontologics/redis-connectors",
  "version": "0.1.0",
  "description": "Redis connectors for the Ontologic command bus: streams for commands, pub/sub for responses.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "build:release": "pnpm run clean && tsc --project tsconfig-release.json",
    "prepack": "pnpm run build:release",
    "test": "vitest run",
    "test:report": "vitest run && vite preview --outDir reports"
  },
  "keywords": [
    "ontologic",
    "command-bus",
    "redis",
    "redis-streams",
    "connector",
    "typescript"
  ],
  "author": "SachaCR",
  "license": "MIT",
  "homepage": "https://ontologic.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/SachaCR/ontologic.git",
    "directory": "packages/redis-connectors"
  },
  "bugs": {
    "url": "https://github.com/SachaCR/ontologic/issues"
  },
  "dependencies": {
    "redis": "^6.2.1"
  },
  "peerDependencies": {
    "ontologic": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "ontologic": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
